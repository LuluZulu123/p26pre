var builder = WebApplication.CreateBuilder(args);

builder.Services.AddSession();
builder.Services.AddDistributedMemoryCache();

var app = builder.Build();

app.UseDeveloperExceptionPage();
app.UseWebSockets();
app.UseDefaultFiles();
app.UseStaticFiles();
app.UseSession();
app.Run(async (ctxy) => Startup.Run(ctxy));
// app.Map("/", async (ctxy) => Startup.RunNws(ctxy));
// app.Map("/o/websocket", async (ctxy) => Startup.RunWs(ctxy));

app.Run();