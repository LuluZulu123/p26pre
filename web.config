<configuration>
	<system.web>
		<customErrors mode="Off"/>
	</system.web>
	<system.webServer>
		<rewrite>
			<rules>
				<rule name="ws">
					<match url="(.*)" />
					<conditions>
						<add input="{CACHE_URL}" pattern="^ws://" />
					</conditions>
					<action type="Rewrite" url="http://{SERVER_NAME}/{R:1}" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
</configuration>